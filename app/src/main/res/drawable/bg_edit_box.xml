<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/input_corner_radius" />
            <solid android:color="@color/input_disabled" />
            <stroke android:width="1dp" android:color="@color/border" />
            <padding android:left="14dp" android:top="9dp" android:right="10dp" android:bottom="9dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/input_corner_radius" />
            <solid android:color="@color/input_focused" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <padding android:left="13dp" android:top="8dp" android:right="9dp" android:bottom="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/input_corner_radius" />
            <solid android:color="@color/input_focused" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <padding android:left="13dp" android:top="8dp" android:right="9dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/input_corner_radius" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/border" />
            <padding android:left="14dp" android:top="9dp" android:right="10dp" android:bottom="9dp" />
        </shape>
    </item>
</selector>
