<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_chat_canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:minHeight="64dp"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/icon_padding"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPeerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConnect"
            style="@style/Widget.OfflineConnect.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_height"
            android:layout_marginStart="2dp"
            android:minWidth="68dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/connect"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnChatMenu"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_options"
            android:padding="@dimen/icon_padding"
            android:src="@drawable/ic_more_vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chatSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:elevation="1dp"
        android:background="@drawable/bg_edit_box"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editChatSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:cursorVisible="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/search_messages"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textCursorDrawable="@null" />

        <TextView
            android:id="@+id/txtSearchResultCount"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnClearChatSearch"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_search"
            android:padding="@dimen/icon_padding_compact"
            android:src="@drawable/ic_clear"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSearchPrevious"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous_search_result"
            android:padding="@dimen/icon_padding_compact"
            android:src="@drawable/ic_arrow_up"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSearchNext"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next_search_result"
            android:padding="@dimen/icon_padding_compact"
            android:src="@drawable/ic_arrow_down"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="58dp">

            <LinearLayout
                android:id="@+id/messageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtConversationEmpty"
                    style="@style/TextAppearance.OfflineConnect.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="56dp"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="@string/conversation_empty" />
            </LinearLayout>
        </ScrollView>

        <ImageButton
            android:id="@+id/btnScrollBottom"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_scroll_to_bottom"
            android:contentDescription="@string/scroll_to_latest"
            android:elevation="1dp"
            android:padding="@dimen/icon_padding_compact"
            android:src="@drawable/ic_arrow_down"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/chatComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_composer"
        android:elevation="8dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnAttachment"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_attachment"
            android:padding="@dimen/icon_padding"
            android:src="@drawable/ic_attachment" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRecordingHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/recording_voice"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/recordingPanel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_recording_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <View
                    android:id="@+id/recordingDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_recording_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtRecordingTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_zero"
                        android:textColor="#B42318"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRecordingAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/recording_release_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCancelRecording"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel_recording"
                    android:padding="@dimen/icon_padding"
                    android:src="@drawable/ic_delete"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnSendRecording"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:background="@drawable/bg_button_primary"
                    android:contentDescription="@string/send_recording"
                    android:padding="@dimen/icon_padding"
                    android:src="@drawable/ic_send"
                    app:tint="@color/on_primary"
                    android:visibility="gone" />
            </LinearLayout>

            <EditText
                android:id="@+id/editMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit_box"
                android:gravity="top|start"
                android:hint="@string/message_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:maxLength="4096"
                android:maxLines="4"
                android:minHeight="@dimen/control_height"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textCursorDrawable="@null"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEmoji"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/emoji"
            android:padding="@dimen/icon_padding"
            android:src="@drawable/ic_emoji" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_button_primary"
            android:contentDescription="@string/record_voice"
            android:padding="@dimen/icon_padding"
            android:src="@drawable/ic_mic" />
    </LinearLayout>
</LinearLayout>
