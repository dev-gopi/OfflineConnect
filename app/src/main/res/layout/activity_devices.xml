<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/devicesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/screen_horizontal_padding"
    android:paddingBottom="16dp">

    <ImageButton
        android:id="@+id/btnBackDevices"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_alignParentStart="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="@dimen/icon_padding"
        android:src="@drawable/ic_back" />

    <TextView
        android:id="@+id/txtDevicesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="false"
        android:layout_marginStart="8dp"
        android:layout_alignTop="@id/btnBackDevices"
        android:layout_alignBottom="@id/btnBackDevices"
        android:gravity="center_vertical"
        android:layout_toEndOf="@id/btnBackDevices"
        android:text="@string/nearby_devices"
        android:textAppearance="@style/TextAppearance.OfflineConnect.ScreenTitle" />

    <TextView
        android:id="@+id/txtDevicesDescription"
        style="@style/TextAppearance.OfflineConnect.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtDevicesTitle"
        android:layout_alignStart="@id/txtDevicesTitle"
        android:layout_marginTop="4dp"
        android:text="@string/nearby_devices_description" />

    <Button
        android:id="@+id/btnScan"
        style="@style/Widget.OfflineConnect.PrimaryButton"
        android:layout_width="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:minWidth="184dp"
        android:text="@string/scan" />

    <LinearLayout
        android:id="@+id/deviceSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height"
        android:layout_below="@id/txtDevicesDescription"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edit_box"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editDeviceSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_devices"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnClearDeviceSearch"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_search"
            android:padding="@dimen/icon_padding_compact"
            android:src="@drawable/ic_clear"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/deviceListCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/deviceSearchContainer"
        android:layout_above="@id/btnScan"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/txtDiscoveryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_status"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/ready_to_scan"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressDiscovery"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtDevicesEmpty"
            style="@style/TextAppearance.OfflineConnect.Body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/devices_empty"
            android:textAlignment="center" />

        <ListView
            android:id="@+id/listDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:contentDescription="@string/nearby_devices"
            android:divider="@color/border"
            android:dividerHeight="1dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_device" />
    </LinearLayout>
</RelativeLayout>
